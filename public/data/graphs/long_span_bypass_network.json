        {
          "label": "rank 7",
          "variant": "gray"
        }
      ]
    },
    {
      "id": "egress",
      "name": "Egress Filter",
      "type": "stage",
      "description": "Strips internal fields before the body leaves the perimeter.",
      "badges": [
        {
          "label": "rank 8",
          "variant": "gray"
        }
      ]
    },
    {
      "id": "client",
      "name": "Client",
      "type": "end",
