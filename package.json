{
  "name": "gvui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:daemon": "docker compose -f docker-compose.dev.yml up -d --build",
    "stop": "docker compose -f docker-compose.dev.yml down",
    "restart": "docker compose -f docker-compose.dev.yml restart",
    "logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:local": "vite",
    "build:local": "tsc -b && vite build",
    "preview:local": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check",
    "build": "bun run build:local",
    "prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:stop": "docker compose -f docker-compose.prod.yml down",
    "prod:restart": "docker compose -f docker-compose.prod.yml restart",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@dagrejs/dagre": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
