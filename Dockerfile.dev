# Development Dockerfile using Bun
FROM oven/bun:latest

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain (minimal profile with wasm32 target)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --target wasm32-unknown-unknown
ENV PATH="/root/.cargo/bin:${PATH}"

# Install wasm-pack
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

# Copy package manifests
COPY package.json bun.lock* ./

# Install dependencies
RUN bun install

# Copy application code
COPY . .

# Expose gvui dev port
EXPOSE 48173

# Start development server with live watch mode
CMD ["bun", "run", "dev:local", "--", "--host", "0.0.0.0"]
