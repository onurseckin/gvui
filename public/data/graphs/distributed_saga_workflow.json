{
  "id": "saga-workflow-01",
  "title": "Distributed Transaction Saga Workflow",
  "directed": true,
  "nodes": [
    {
      "id": "saga-orchestrator",
      "name": "Saga Orchestrator",
      "type": "orchestrator",
      "description": "Central coordinator for distributed checkout transactions",
      "badges": [
        { "label": "Status: Active", "variant": "success" },
        { "label": "TPS: 3,400", "variant": "info" }
      ]
    },
    {
      "id": "order-service",
      "name": "Order Service",
      "type": "service",
      "description": "Order creation and state persistence",
      "badges": [
        { "label": "Status: Healthy", "variant": "success" },
        { "label": "Latency: 18ms", "variant": "info" }
      ]
    },
    {
      "id": "inventory-service",
      "name": "Inventory Service",
      "type": "service",
      "description": "Stock reservation and SKU management",
      "badges": [
        { "label": "Status: Healthy", "variant": "success" },
        { "label": "Reservations: 12.8k/min", "variant": "info" }
      ]
    },
    {
      "id": "payment-service",
      "name": "Payment Service",
      "type": "service",
      "description": "Payment authorization and charge settlement",
      "badges": [
        { "label": "Status: Degrading", "variant": "amber" },
        { "label": "Latency: 320ms", "variant": "amber" }
      ]
    },
    {
      "id": "shipping-service",
      "name": "Shipping Service",
      "type": "service",
      "description": "Logistics label generation and dispatch",
      "badges": [{ "label": "Status: Healthy", "variant": "success" }]
    },
    {
      "id": "notification-service",
      "name": "Notification Service",
      "type": "service",
      "description": "Email, SMS, and Push notifications",
      "badges": [{ "label": "Status: Healthy", "variant": "success" }]
    },
    {
      "id": "refund-compensator",
      "name": "Refund Compensator",
      "type": "executor",
      "description": "Reverses payment authorization on saga failure",
      "badges": [{ "label": "Mode: Compensating", "variant": "amber" }]
    },
    {
      "id": "stock-reclaimer",
      "name": "Stock Reclaimer",
      "type": "executor",
      "description": "Releases reserved inventory on rollback",
      "badges": [{ "label": "Mode: Compensating", "variant": "amber" }]
    },
    {
      "id": "saga-log-db",
      "name": "Saga State Store",
      "type": "datastore",
      "description": "Event-sourced WAL database",
      "badges": [{ "label": "IOPS: 15,200", "variant": "info" }]
    },
    {
      "id": "analytics-pipeline",
      "name": "Analytics Pipeline",
      "type": "datastore",
      "description": "Real-time transaction metrics sink",
      "badges": [{ "label": "Lag: 0.4s", "variant": "success" }]
    }
  ],
  "edges": [
    {
      "id": "se1",
      "source": "saga-orchestrator",
      "target": "order-service",
      "label": "1. create pending order"
    },
    {
      "id": "se2",
      "source": "saga-orchestrator",
      "target": "saga-log-db",
      "label": "checkpoint state"
    },
    {
      "id": "se3",
      "source": "order-service",
      "target": "inventory-service",
      "label": "2. reserve stock"
    },
    {
      "id": "se4",
      "source": "order-service",
      "target": "payment-service",
      "label": "3. process payment"
    },
    {
      "id": "se5",
      "source": "payment-service",
      "target": "refund-compensator",
      "label": "payment failed",
      "variant": "danger"
    },
    {
      "id": "se6",
      "source": "refund-compensator",
      "target": "stock-reclaimer",
      "label": "↺ rollback inventory",
      "isCycle": true
    },
    {
      "id": "se7",
      "source": "stock-reclaimer",
      "target": "order-service",
      "label": "↺ mark order failed",
      "isCycle": true
    },
    {
      "id": "se8",
      "source": "payment-service",
      "target": "shipping-service",
      "label": "4. dispatch shipment"
    },
    {
      "id": "se9",
      "source": "shipping-service",
      "target": "notification-service",
      "label": "5. send tracking email"
    },
    {
      "id": "se10",
      "source": "notification-service",
      "target": "analytics-pipeline",
      "label": "emit order analytics"
    },
    {
      "id": "se11",
      "source": "order-service",
      "target": "analytics-pipeline",
      "label": "stream metrics"
    }
  ]
}
